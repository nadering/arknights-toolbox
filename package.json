{
  "name": "arknights-toolbox",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:operators": "vitest run tests/operators",
    "test:depot": "vitest run tests/depot",
    "typecheck": "tsc --noEmit",
    "check:release": "npm run test && npm run typecheck && npm run lint && npm run build",
    "test:refresh-skadi": "tsx scripts/testing/capture-skadi-fixture.ts",
    "extract:operator-overrides": "tsx scripts/operator-meta/extract-operator-overrides.ts",
    "check:gamedata": "tsx scripts/operator-release/check-gamedata-path.ts",
    "check:cn-gamedata": "tsx scripts/operator-release/check-cn-gamedata-path.ts",
    "scan:operator-release": "tsx scripts/operator-release/scan-release-candidates.ts",
    "scan:cn-operator-release": "tsx scripts/operator-release/scan-cn-release-candidates.ts",
    "create:operator-release-event-draft": "tsx scripts/operator-release/create-operator-release-event-draft.ts",
    "generate:operator-release-info": "tsx scripts/operator-release/generate-operator-release-info.ts",
    "generate:operators": "tsx scripts/operator-generator/generate-operators.ts"
  },
  "dependencies": {
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.2.0",
    "firebase": "^12.14.0",
    "framer-motion": "^12.23.22",
    "jotai": "^2.10.1",
    "next": "16.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "^0.35.0",
    "tailwind-scrollbar-hide": "^1.1.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "9.39.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "^5.0.4",
    "dotenv": "^17.4.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.1.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^5.0.4"
  },
  "overrides": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "protobufjs": "7.6.5"
  }
}
